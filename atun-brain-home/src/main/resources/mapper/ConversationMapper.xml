<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atun.brain.infrastructure.persistence.mybatis.mapper.ConversationMapper">
    
    <resultMap id="BaseResultMap" type="com.atun.brain.entity.Conversation">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="session_id" property="sessionId"/>
        <result column="agent_type" property="agentType"/>
        <result column="created_at" property="createdAt"/>
        <result column="last_active_at" property="lastActiveAt"/>
    </resultMap>
    
    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM conversation WHERE id = #{id}
    </select>
    
    <select id="findBySessionId" resultMap="BaseResultMap">
        SELECT * FROM conversation WHERE session_id = #{sessionId}
    </select>
    
    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT * FROM conversation
        WHERE user_id = #{userId}
        ORDER BY last_active_at DESC
    </select>
    
    <select id="findByUserIdAndAgentType" resultMap="BaseResultMap">
        SELECT * FROM conversation
        WHERE user_id = #{userId} AND agent_type = #{agentType}
        ORDER BY last_active_at DESC
    </select>
    
    <insert id="insert" parameterType="com.atun.brain.entity.Conversation"
        useGeneratedKeys="true" keyProperty="id">
        INSERT INTO conversation (user_id, session_id, agent_type)
        VALUES (#{userId}, #{sessionId}, #{agentType})
    </insert>
    
    <update id="update" parameterType="com.atun.brain.entity.Conversation">
        UPDATE conversation
        SET agent_type = #{agentType},
            last_active_at = #{lastActiveAt}
        WHERE id = #{id}
    </update>
    
    <update id="updateLastActiveAt">
        UPDATE conversation
        SET last_active_at = NOW()
        WHERE id = #{id}
    </update>
</mapper>