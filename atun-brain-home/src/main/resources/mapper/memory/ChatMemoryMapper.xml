<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atun.brain.home.infrastructure.persistence.mapper.ChatMemoryMapper">

    <resultMap id="ChatMemoryResult" type="com.atun.brain.home.infrastructure.persistence.po.ChatMemoryPO">
        <id column="id" property="id"/>
        <result column="memory_id" property="memoryId"/>
        <result column="messages_json" property="messagesJson"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findByMemoryId" resultMap="ChatMemoryResult">
        SELECT id, memory_id, messages_json, created_at, updated_at
        FROM t_chat_memory
        WHERE memory_id = #{memoryId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_chat_memory (memory_id, messages_json, created_at, updated_at)
        VALUES (#{memoryId}, #{messagesJson}, NOW(), NOW())
    </insert>

    <update id="updateMemory">
        UPDATE t_chat_memory
        SET messages_json = #{messagesJson}, updated_at = NOW()
        WHERE memory_id = #{memoryId}
    </update>

    <delete id="deleteByMemoryId">
        DELETE FROM t_chat_memory WHERE memory_id = #{memoryId}
    </delete>
</mapper>
