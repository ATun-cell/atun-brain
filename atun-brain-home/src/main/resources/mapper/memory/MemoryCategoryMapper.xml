<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atun.brain.home.infrastructure.persistence.mapper.MemoryCategoryMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.atun.brain.home.infrastructure.persistence.po.MemoryCategoryPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="name" property="name"/>
        <result column="parent_id" property="parentId"/>
        <result column="level" property="level"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, user_id, name, parent_id, level, sort_order, created_at, updated_at, deleted
    </sql>

    <!-- 插入记忆分类 -->
    <insert id="insert" parameterType="com.atun.brain.home.infrastructure.persistence.po.MemoryCategoryPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_memory_category (
            user_id, name, parent_id, level, sort_order, created_at, updated_at, deleted
        ) VALUES (
            #{userId}, #{name}, #{parentId}, #{level}, #{sortOrder}, #{createdAt}, #{updatedAt}, #{deleted}
        )
    </insert>

    <!-- 根据 ID 查询 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_memory_category
        WHERE id = #{id} AND deleted = 0
    </select>

    <!-- 根据用户 ID 查询 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_memory_category
        WHERE user_id = #{userId} AND deleted = 0
        ORDER BY level, sort_order ASC
    </select>

    <!-- 根据父分类 ID 查询 -->
    <select id="selectByParentId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_memory_category
        WHERE parent_id = #{parentId} AND deleted = 0
        ORDER BY sort_order ASC
    </select>

    <!-- 更新记忆分类 -->
    <update id="update" parameterType="com.atun.brain.home.infrastructure.persistence.po.MemoryCategoryPO">
        UPDATE t_memory_category
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="level != null">level = #{level},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 逻辑删除 -->
    <update id="deleteLogic">
        UPDATE t_memory_category
        SET deleted = 1, updated_at = NOW()
        WHERE id = #{id}
    </update>

</mapper>
