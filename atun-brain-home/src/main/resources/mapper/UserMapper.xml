<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atun.brain.infrastructure.persistence.mybatis.mapper.UserMapper">
    
    <resultMap id="BaseResultMap" type="com.atun.brain.infrastructure.persistence.mybatis.po.UserPO">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="email" property="email"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="preferences" property="preferences"/>
        <result column="active" property="active"/>
        <result column="last_login_at" property="lastLoginAt"/>
        <result column="email_verified" property="emailVerified"/>
        <result column="role" property="role"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="bio" property="bio"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>
    
    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM user WHERE id = #{id}
    </select>
    
    <select id="findByUsername" resultMap="BaseResultMap">
        SELECT * FROM user WHERE username = #{username}
    </select>
    
    <select id="findByEmail" resultMap="BaseResultMap">
        SELECT * FROM user WHERE email = #{email}
    </select>
    
    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM user ORDER BY created_at DESC
    </select>
    
    <select id="findAllActive" resultMap="BaseResultMap">
        SELECT * FROM user WHERE active = TRUE ORDER BY created_at DESC
    </select>
    
    <select id="findByCreatedAfter" resultMap="BaseResultMap">
        SELECT * FROM user WHERE created_at &gt; #{dateTime} ORDER BY created_at DESC
    </select>
    
    <select id="findByLastLoginAfter" resultMap="BaseResultMap">
        SELECT * FROM user WHERE last_login_at &gt; #{dateTime} ORDER BY last_login_at DESC
    </select>
    
    <select id="findByEmailVerified" resultMap="BaseResultMap">
        SELECT * FROM user WHERE email_verified = #{verified} ORDER BY created_at DESC
    </select>
    
    <select id="findByRole" resultMap="BaseResultMap">
        SELECT * FROM user WHERE role = #{role} ORDER BY created_at DESC
    </select>
    
    <select id="existsByUsername" resultType="int">
        SELECT COUNT(*) FROM user WHERE username = #{username}
    </select>
    
    <select id="existsByEmail" resultType="int">
        SELECT COUNT(*) FROM user WHERE email = #{email}
    </select>
    
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM user
    </select>
    
    <select id="countActive" resultType="long">
        SELECT COUNT(*) FROM user WHERE active = TRUE
    </select>
    
    <insert id="insert" parameterType="com.atun.brain.infrastructure.persistence.mybatis.po.UserPO"
        useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, email, password_hash, preferences, active, email_verified, role, avatar_url, bio, created_at, updated_at)
        VALUES (#{username}, #{email}, #{passwordHash}, #{preferences}, #{active}, #{emailVerified}, #{role}, #{avatarUrl}, #{bio}, NOW(), NOW())
    </insert>
    
    <update id="update" parameterType="com.atun.brain.infrastructure.persistence.mybatis.po.UserPO">
        UPDATE user
        SET username = #{username},
            email = #{email},
            password_hash = #{passwordHash},
            preferences = #{preferences},
            active = #{active},
            last_login_at = #{lastLoginAt},
            email_verified = #{emailVerified},
            role = #{role},
            avatar_url = #{avatarUrl},
            bio = #{bio},
            updated_at = NOW()
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM user WHERE id = #{id}
    </delete>
</mapper>