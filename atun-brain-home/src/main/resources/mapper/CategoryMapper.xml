<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atun.brain.infrastructure.persistence.mybatis.mapper.CategoryMapper">
    
    <resultMap id="BaseResultMap" type="com.atun.brain.entity.Category">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="parent_id" property="parentId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>
    
    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM category WHERE id = #{id}
    </select>
    
    <select id="findByName" resultMap="BaseResultMap">
        SELECT * FROM category WHERE name = #{name}
    </select>
    
    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM category ORDER BY type, parent_id, name
    </select>
    
    <select id="findByType" resultMap="BaseResultMap">
        SELECT * FROM category WHERE type = #{type}
        ORDER BY parent_id, name
    </select>
    
    <select id="findByParentId" resultMap="BaseResultMap">
        SELECT * FROM category WHERE parent_id = #{parentId}
        ORDER BY name
    </select>
    
    <insert id="insert" parameterType="com.atun.brain.entity.Category"
        useGeneratedKeys="true" keyProperty="id">
        INSERT INTO category (name, type, parent_id)
        VALUES (#{name}, #{type}, #{parentId})
    </insert>
    
    <update id="update" parameterType="com.atun.brain.entity.Category">
        UPDATE category
        SET name = #{name},
            type = #{type},
            parent_id = #{parentId}
        WHERE id = #{id}
    </update>
</mapper>